    {
      "name": "Eingabe prüfen [Code]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        496
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Prüft die Eingaben des Aufrufers, bevor etwas geschrieben wird.\n// Erlaubnisliste: nur diese Tabellen darf der Sub beschreiben. Neue Tabellen kommen nur nach Freigabe des Betreibers hinzu.\nconst ERLAUBT = ['agt_w06_support_log', 'agt_w06_sub_test'];\nconst inp = $input.first().json;\nconst table = String(inp.table_name ?? '').trim();\nconst row = inp.row;\nconst runId = inp.run_id == null ? '' : String(inp.run_id);\nlet err = '';\nif (!table) err = 'table_name fehlt';\nelse if (!ERLAUBT.includes(table)) err = 'Tabelle nicht erlaubt: ' + table.slice(0, 60);\nelse if (row === null || typeof row !== 'object' || Array.isArray(row)) err = 'row muss ein Objekt sein';\nelse if (Object.keys(row).length === 0) err = 'row ist leer';\nreturn [{ json: { valid: err === '', error_text: err, table_name: table, run_id: runId, row: err === '' ? row : null } }];"
      }
    },
    {
      "name": "Eingabe gültig? [If]",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        688,
        496
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Zeile vorbereiten [Code]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        496
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Macht aus der Zeile des Aufrufers das Element, das der Supabase-Knoten Spalte für Spalte übernimmt.\nreturn [{ json: $input.first().json.row }];"
      }
    },
