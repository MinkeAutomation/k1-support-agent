              "value": -1,
              "type": "number"
            },
            {
              "id": "a03",
              "name": "jev_anliegen",
              "value": "",
              "type": "string"
            },
            {
              "id": "a04",
              "name": "jev_anliegen_conf",
              "value": -1,
              "type": "number"
            },
            {
              "id": "a05",
              "name": "jev_cost_usd",
              "value": -1,
              "type": "number"
            },
            {
              "id": "a06",
              "name": "jev_model_answer",
              "value": "",
              "type": "string"
            },
            {
              "id": "a07",
              "name": "jev_attempts",
              "value": "={{ $json.jev_attempts ?? ($(\"K1-Bezug erneut prüfen [HTTP Request]\").isExecuted ? 2 : 1) }}",
              "type": "number"
            },
            {
              "id": "a08",
              "name": "error_text",
              "value": "={{ String($json.jev_error || $json.error?.message || $json.error || \"Jev nicht erreichbar\").slice(0, 200) }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false
      }
    },
    {
      "name": "Eingabe ungültig [Stop and Error]",
